{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "irodori-studio",
  "version": "../package.json",
  "identifier": "com.aileap.irodori-studio",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/gen-licenses.mjs && node scripts/check-staged.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "irodori-studio",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "publisher": "appdevelopmentworks",
    "copyright": "Copyright (c) 2026 appdevelopmentworks",
    "shortDescription": "Unofficial desktop app for the Japanese TTS model Irodori-TTS",
    "resources": {
      "../resources/": "",
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Japanese", "English", "SimpChinese", "German"]
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "./macos/en.lproj/InfoPlist.strings",
        "Resources/ja.lproj/InfoPlist.strings": "./macos/ja.lproj/InfoPlist.strings",
        "Resources/zh-Hans.lproj/InfoPlist.strings": "./macos/zh-Hans.lproj/InfoPlist.strings",
        "Resources/de.lproj/InfoPlist.strings": "./macos/de.lproj/InfoPlist.strings"
      }
    }
  }
}
